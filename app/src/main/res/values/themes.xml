<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Sand window background (the iOS LaunchBackground) while Compose starts. -->
    <style name="Theme.Oasis" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/sand</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- Mildcrowd draws its own dark mode (values-night, „Darstellung“); the system must not darken it again. -->
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
    </style>
    <color name="sand">#F4F5FA</color>
    <!-- The accent blue behind the launcher icon; the same in dark mode. -->
    <color name="launcher">#5560E0</color>
</resources>
