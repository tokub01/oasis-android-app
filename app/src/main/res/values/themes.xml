<resources>
    <!-- Sand window background (the iOS LaunchBackground) while Compose starts. -->
    <style name="Theme.Oasis" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/sand</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <color name="sand">#F4EDE1</color>
</resources>
