<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Sand window background (the iOS LaunchBackground) while Compose starts. -->
    <style name="Theme.Oasis" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/sand</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- Oasis has one light design, like iOS (UIUserInterfaceStyle Light) and the web (color-scheme: light). -->
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
    </style>
    <color name="sand">#F4EDE1</color>
</resources>
