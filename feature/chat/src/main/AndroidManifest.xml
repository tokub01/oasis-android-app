<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Unlocking the chat with a fingerprint or face (BiometricPrompt). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Voice messages, asked for at runtime with an explanation; devices without a microphone keep the rest of the chat. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application>
        <!-- Hands decrypted files ("Öffnen", "Teilen") to other apps with read permission only. -->
        <provider
            android:name="de.velwebsolutions.oasis.chat.core.ChatFileProvider"
            android:authorities="${applicationId}.chat.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/chat_file_paths" />
        </provider>
    </application>
</manifest>
