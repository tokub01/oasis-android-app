{
  "comment": "Spam checks of the chat on the own device (docs/mildcrowd-chat-client.md, \"Schreien, Wiederholungen, Fluten\"). Every client must decide the drafts and the flood sequences exactly as given. Drafts: `hint` is \"shouting\", \"repetition\" or null (shouting wins when both match); a hint needs a second press on the send button (`texts.send_anyway`) and never changes the text. Flood: each send is [seconds, text] in one chat; `waits` gives per send the seconds until sending works again (0: it leaves and counts; otherwise it is not sent, does not count, and a new pause starts only once the previous one ended). Checked by tests/js/chat/spam.test.mjs; iOS and Android copy this file byte-identical.",
  "rules": {
    "shouting": {
      "min_letters": 12,
      "upper_percent": 70,
      "ignore_words_up_to_letters": 3,
      "definition": "Split at white space; tokens starting with @, http://, https:// or www. (any case) are left out. In the others, words are runs of letters and combining marks (\\p{L}\\p{M}); a word counts with its letters (\\p{L}) only when it has more than 3. Shouting when letters >= 12 and upper (\\p{Lu}) * 100 >= letters * 70."
    },
    "repetition": {
      "same_word_in_a_row": 4,
      "same_character_more_than": 8,
      "definition": "Words: split at white space, lower case (locale-independent), keep only \\p{L}\\p{M}\\p{N}; tokens that become empty are skipped. Repetitive when the same word comes 4 or more times in a row, or the same grapheme cluster (extended, so 👍🏽 and ❤️ are one) more than 8 times in a row; graphemes are compared by their code points (no canonical equivalence: Swift must compare unicodeScalars); graphemes of white space or digits only never count and break the run."
    },
    "flood": {
      "same_text_in_a_row": 3,
      "same_text_within_seconds": 120,
      "max_messages": 10,
      "max_messages_within_seconds": 30,
      "pause_seconds": 30,
      "definition": "Per chat, over the own sends that left: a send is held when the 2 sends before it have the same trimmed, non-empty text as it and the first of them is at most 120 seconds old, or when 10 sends left in the last 30 seconds (now - at < 30). A held send starts a pause of 30 seconds; during it every send waits ceil(paused_until - now) seconds."
    },
    "server": {
      "per_chat_per_minute": 20,
      "status": 429,
      "message": "Kurz durchatmen – du kannst gleich weiterschreiben."
    }
  },
  "texts": {
