# Copy to secrets.properties (not committed). Values can also come from environment variables of the same name.

# The staging gate's password, sent as X-Oasis-Gate to staging.get-oasis.com (staging build type only).
OASIS_GATE_KEY=

# Debug builds on a real phone: the Mac's LAN address instead of the emulator's 10.0.2.2.
# OASIS_DEBUG_BASE_URL=http://192.168.1.20
# OASIS_DEBUG_REVERB_HOST=192.168.1.20
